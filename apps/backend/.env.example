# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/dominoclub?schema=public"

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────────
# Google Sign-In
# Web application OAuth client — used as the audience when verifying
# ID tokens sent by the mobile app's native Google Sign-In SDK.
# ──────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ──────────────────────────────────────────────
# PIX — Banco Inter
# ──────────────────────────────────────────────
INTER_CLIENT_ID=96703fe2d355c5d53fa606e364f241a6c6b95664
INTER_CLIENT_SECRET=b6e37717d9cdbc8f3a0654eb4162e502377af7fe
INTER_BASE_URL=https://cdpj-sandbox.partners.uatinter.co
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
INTER_PIX_KEY=your_pix_key_here
INTER_WEBHOOK_URL=https://your-domain.com/api/v1/wallet/pix/webhook
INTER_WEBHOOK_SECRET=your_hmac_secret_here

# ──────────────────────────────────────────────
# Serpro CPF Validation
# ──────────────────────────────────────────────
SERPRO_API_KEY=your_serpro_api_key
SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br
SERPRO_MOCK_MODE=true

# ──────────────────────────────────────────────
# OTP / SMS
# ──────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS provider: mock | zenvia | twilio
SMS_PROVIDER=mock

# Zenvia (Brazil-native — recommended for production)
# SMS_API_KEY=your_zenvia_api_token
# SMS_SENDER=DominoClub

# Twilio (international fallback)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ──────────────────────────────────────────────
# Anti-fraud & Rate limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_COUNTRIES=BR
BOT_SCORE_THRESHOLD=0.8

# ──────────────────────────────────────────────
# Game
# ──────────────────────────────────────────────
TURN_TIMEOUT_SECONDS=30
BOT_INJECT_WAIT_SECONDS=30
MATCHMAKING_BET_TOLERANCE=0.10
HOUSE_EDGE_PERCENT=10

# ──────────────────────────────────────────────
# Admin Dashboard
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production
ADMIN_JWT_SECRET=admin_secret_change_in_production_32chars

# ──────────────────────────────────────────────
# Redis (optional — enables Socket.io horizontal scaling)
# Leave blank to run in single-server in-memory mode
# ──────────────────────────────────────────────
# REDIS_URL=redis://:your_redis_password@localhost:6379

# ──────────────────────────────────────────────
# Superuser (usuário com acesso total)
# ──────────────────────────────────────────────
SUPERUSER_PHONE=+5599999999999
SUPERUSER_NAME=Super Admin
SUPERUSER_CPF=11144477735

# ──────────────────────────────────────────────
# Dev Auth Bypass (login automático em desenvolvimento)
# NUNCA defina como true em produção
# ──────────────────────────────────────────────
DEV_AUTH_BYPASS=false
DEV_AUTH_DEFAULT_PHONE=+5599999999999

# ──────────────────────────────────────────────
# Mocks de desenvolvimento (NUNCA true em produção)
# ──────────────────────────────────────────────
# Aceita qualquer token de integridade (Play Integrity / App Attest)
INTEGRITY_MOCK_MODE=false
INTEGRITY_MOCK_TOKEN=dev-integrity-token
# Aceita qualquer CPF matematicamente válido sem chamar a API Serpro
SERPRO_MOCK_MODE=false
# Auto-confirma depósito PIX após 3 segundos (simula pagamento)
PIX_MOCK_AUTO_CONFIRM=false

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
