// ─────────────────────────────────────────────────────────────────
// DominoClub — Prisma Schema
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────

enum GameMode {
  ARENA_1V1
  CUP_1V1
  TOURNAMENT_2V2
  RECREATIONAL_2V2
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
  ABANDONED
}

// Scoring system (win types) — all variants support all four outcomes.
// The variant label describes the RULE SET that differs between game modes:
//   CARROCA : standard pip-count blocked-game resolution
//   L_E_L   : doubles count double in blocked-game pip totals
//   CRUZADA : (reserved for future rule variant; currently plays like CARROCA)
// Win types that occur during any game:
//   Simples (1 pt)  — plain win
//   Carroça (2 pts) — winning tile is a double
//   Lá e Lô (3 pts) — winning tile makes both open ends equal
//   Cruzada (4 pts) — winning tile is a double AND both ends equal
enum DominoVariant {
  CARROCA
  L_E_L
  CRUZADA
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  BONUS
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TournamentStatus {
  OPEN
  FULL
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum FraudType {
  MULTI_ACCOUNT_DEVICE
  MULTI_ACCOUNT_IP
  SUSPICIOUS_GPS
  GEOLOCATION_OUTSIDE_BRAZIL
  RAPID_FIRE_BETS
  BOT_PATTERN
  COLLUSION_SUSPECTED
  UNUSUAL_WIN_RATE
  IMPOSSIBLE_MOVEMENT
  INTEGRITY_FAIL
  VELOCITY_ABUSE
  DEVICE_LIMIT_EXCEEDED
  ADMIN_ACTION
}

// ─── KYC ─────────────────────────────────────────────────────────

enum DocumentType {
  RG
  CNH
  PASSPORT
}

enum DocumentStatus {
  PENDING // uploaded, awaiting review
  APPROVED
  REJECTED
}

// ─── Leagues & Ranking ───────────────────────────────────────────

// Thresholds: Silver 200, Gold 700, Platinum 1200, Diamond 1700
enum LeagueRank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// ─── Models ──────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  cpf           String?   @unique
  email         String?   @unique
  google_id     String?   @unique
  name          String?
  avatar        String?
  date_of_birth DateTime?

  // Location / device
  gps_lat        Float?
  gps_lng        Float?
  gps_accuracy   Float?
  gps_updated_at DateTime?
  device_id      String?
  ip_address     String?
  push_token     String? // Expo push token for notifications

  // Moderation
  is_banned   Boolean @default(false)
  ban_reason  String?
  bot_score   Float   @default(0) // 0–1 probability of being a bot
  trust_score Float   @default(1.0) // 1.0 = fully trusted; decrements on abuse signals

  // Verification
  cpf_verified   Boolean   @default(false)
  phone_verified Boolean   @default(false)
  otp_code       String?
  otp_expires_at DateTime?
  refresh_token  String?

  // KYC — required before first withdrawal
  kyc_document_type      DocumentType?
  kyc_document_status    DocumentStatus?
  kyc_document_front_url String?
  kyc_document_back_url  String?
  kyc_selfie_url         String?
  kyc_submitted_at       DateTime?
  kyc_reviewed_at        DateTime?
  kyc_review_notes       String?         @db.Text

  // League / Ranking — resets monthly
  league_points       Int         @default(0)
  previous_rank       LeagueRank? // rank earned in the previous month
  previous_rank_month String? // "YYYY-MM" of the month that rank was earned

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  wallet            Wallet?
  gamePlayers       GamePlayer[]
  tournamentPlayers TournamentPlayer[]
  fraudLogs         FraudLog[]
  couponRedemptions CouponRedemption[]
  wonGames          Game[]                 @relation("GameWinner")
  deviceBinds       DeviceBind[]
  announcementViews UserAnnouncementView[]

  @@index([phone])
  @@index([cpf])
  @@index([device_id])
  @@index([ip_address])
  @@index([kyc_document_status])
  @@index([league_points])
}

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @unique
  real_balance       Decimal  @default(0) @db.Decimal(12, 2)
  bonus_balance      Decimal  @default(0) @db.Decimal(12, 2)
  rollover_remaining Decimal  @default(0) @db.Decimal(12, 2) // wagering requirement remaining
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  type          TransactionType
  amount        Decimal           @db.Decimal(12, 2)
  balance_after Decimal?          @db.Decimal(12, 2) // snapshot of balance after transaction
  pix_id        String? // Inter txid / e2eid
  pix_qr_code   String?           @db.Text
  pix_key       String? // destination pix key for withdrawals
  description   String?
  status        TransactionStatus @default(PENDING)
  metadata      Json? // extra Inter API response data
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([pix_id])
  @@index([status])
  @@index([created_at])
}

model Game {
  id               String        @id @default(uuid())
  mode             GameMode
  variant          DominoVariant @default(CARROCA)
  status           GameStatus    @default(WAITING)
  bet_amount       Decimal       @default(0) @db.Decimal(12, 2)
  prize_pool       Decimal       @default(0) @db.Decimal(12, 2)
  house_fee        Decimal       @default(0) @db.Decimal(12, 2)
  winner_id        String?
  winning_team     Int? // 1 or 2 for 2v2
  replay_data      Json? // full game history for replay
  room_code        String?       @unique // short code for private games
  tournamentId     String? // null for non-tournament games
  tournament_round Int? // which round of the tournament (1-based)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  started_at       DateTime?
  finished_at      DateTime?

  players    GamePlayer[]
  winner     User?        @relation("GameWinner", fields: [winner_id], references: [id])
  tournament Tournament?  @relation(fields: [tournamentId], references: [id])

  @@index([status])
  @@index([mode])
  @@index([created_at])
  @@index([tournamentId])
}

model GamePlayer {
  id          String   @id @default(uuid())
  gameId      String
  userId      String
  team        Int // 1 or 2
  seat        Int // 0–3 (position at the table)
  final_score Int? // pip count remaining in hand at game end
  is_bot      Boolean  @default(false)
  connected   Boolean  @default(true)
  joined_at   DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@unique([gameId, seat])
  @@index([gameId])
  @@index([userId])
}

model Tournament {
  id                 String           @id @default(uuid())
  name               String
  mode               GameMode
  variant            DominoVariant    @default(CARROCA)
  status             TournamentStatus @default(OPEN)
  entry_fee          Decimal          @db.Decimal(12, 2)
  prize_pool         Decimal          @default(0) @db.Decimal(12, 2)
  initial_prize_pool Decimal          @default(0) @db.Decimal(12, 2) // admin-set prize for in-person events
  max_players        Int
  current_players    Int              @default(0)
  current_round      Int              @default(0) // 0 = not started
  starts_at          DateTime
  finished_at        DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  // In-person event fields
  is_in_person Boolean   @default(false)
  address      String?
  checkin_time DateTime?
  banner_url   String?

  players TournamentPlayer[]
  games   Game[]

  @@index([status])
  @@index([starts_at])
  @@index([is_in_person])
}

model TournamentPlayer {
  id             String    @id @default(uuid())
  tournamentId   String
  userId         String
  seed           Int? // 1 = best; assigned at start based on league_points
  eliminated_at  DateTime?
  withdrawn_at   DateTime? // set alongside eliminated_at when player voluntarily leaves
  final_position Int?
  prize_won      Decimal   @default(0) @db.Decimal(12, 2)
  joined_at      DateTime  @default(now())

  // In-person ticket fields
  participant_name String?
  participant_cpf  String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([seed])
}

model FraudLog {
  id          String    @id @default(uuid())
  userId      String
  type        FraudType
  reason_code String? // structured code: e.g. "BOT_PATTERN:ema_threshold"
  details     Json
  ip_address  String?
  device_id   String?
  resolved    Boolean   @default(false)
  created_at  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([reason_code])
  @@index([resolved])
  @@index([created_at])
}

model DeviceBind {
  id            String   @id @default(uuid())
  userId        String
  device_id     String
  platform      String? // 'android' | 'ios'
  attest_key_id String? // App Attest keyId for iOS
  first_seen    DateTime @default(now())
  last_seen     DateTime @default(now())
  is_active     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, device_id])
  @@index([device_id])
  @@index([userId])
}

// ─── Dynamic system configuration (admin-editable at runtime) ────────────────
model SystemConfig {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

model PairBlock {
  id         String   @id @default(uuid())
  userAId    String
  userBId    String
  reason     String?
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([active])
  @@index([userAId])
  @@index([userBId])
}

model Coupon {
  id                 String      @id @default(uuid())
  code               String      @unique
  bonus_amount       Decimal     @db.Decimal(12, 2)
  min_deposit_amount Decimal     @default(0) @db.Decimal(12, 2)
  rollover_times     Int         @default(0)
  max_players        Int?
  eligible_rank      LeagueRank? // null = all ranks eligible
  expires_at         DateTime? // null = no expiry
  is_active          Boolean     @default(true)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  bonus_amount   Decimal  @db.Decimal(12, 2)
  rollover_added Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// ─── Partner Cooldown (2v2 anti-collusion) ────────────────────────────────────
// Tracks consecutive same-team games for 2v2 pairs.
// After 3 consecutive same-team games, they are forced to opposing teams for 3 games.
model PartnerCooldown {
  id                    String   @id @default(uuid())
  userAId               String
  userBId               String
  consecutive_same_team Int      @default(0)
  cooldown_remaining    Int      @default(0)
  updated_at            DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─── Game Rooms (admin-configurable bet slots) ────────────────────────────────
model GameRoom {
  id         String   @id @default(uuid())
  mode       GameMode
  bet_amount Decimal  @db.Decimal(12, 2)
  label      String?
  locked     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([mode, bet_amount])
  @@index([locked])
  @@index([mode])
}

// ─── Announcements ───────────────────────────────────────────────
// Admin-created global banners/messages sent to users.
model Announcement {
  id            String      @id @default(uuid())
  title         String
  body          String?     @db.Text
  html          String?     @db.Text // optional rich HTML body
  banner_url    String?
  countdown_end DateTime?
  max_shows     Int? // null = always; N = show up to N times per user
  target_rank   LeagueRank? // null = all users
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  views UserAnnouncementView[]

  @@index([is_active])
  @@index([target_rank])
}

model UserAnnouncementView {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  view_count     Int      @default(0)
  last_seen_at   DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}
