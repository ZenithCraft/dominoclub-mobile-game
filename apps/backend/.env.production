# ──────────────────────────────────────────────
# Server (Production)
# ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1

# ──────────────────────────────────────────────
# Database (Docker Compose internal network)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://dominoclub:${POSTGRES_PASSWORD}@postgres:5432/dominoclub

# ──────────────────────────────────────────────
# JWT (Use strong secrets in production)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ──────────────────────────────────────────────
# CORS - Allow VPS IP and mobile app
# ──────────────────────────────────────────────
CORS_ORIGINS=http://34.233.108.8:3001,http://34.233.108.8:3000,http://localhost:3000,http://localhost:19006,http://localhost:8081

# ──────────────────────────────────────────────
# Admin Dashboard
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}

# ──────────────────────────────────────────────
# Game Settings
# ──────────────────────────────────────────────
TURN_TIMEOUT_SECONDS=30
BOT_INJECT_WAIT_SECONDS=4
MATCHMAKING_BET_TOLERANCE=0.10
HOUSE_EDGE_PERCENT=10

# ──────────────────────────────────────────────
# Anti-fraud & Rate limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_COUNTRIES=BR
BOT_SCORE_THRESHOLD=0.8

# ──────────────────────────────────────────────
# OTP / SMS
# ──────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Opções: zenvia | twilio  (NUNCA 'mock' em produção)
SMS_PROVIDER=zenvia
SMS_API_KEY=${SMS_API_KEY}
SMS_SENDER=DominoClub

# ──────────────────────────────────────────────
# PIX - Woovi / OpenPix  (provedor usado pelo código)
# ──────────────────────────────────────────────
WOOVI_APP_ID=${WOOVI_APP_ID}
WOOVI_BASE_URL=https://api.openpix.com.br/api/v1
WOOVI_WEBHOOK_SECRET=${WOOVI_WEBHOOK_SECRET}

# ──────────────────────────────────────────────
# Serpro CPF Validation
# ──────────────────────────────────────────────
SERPRO_API_KEY=${SERPRO_API_KEY}
SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br
SERPRO_MOCK_MODE=false

# ──────────────────────────────────────────────
# E-mail (LGPD export, KYC notifications)
# ──────────────────────────────────────────────
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=DominoClub <noreply@dominoclub.com.br>

# ──────────────────────────────────────────────
# Superuser
# ──────────────────────────────────────────────
SUPERUSER_PHONE=${SUPERUSER_PHONE}
SUPERUSER_NAME=${SUPERUSER_NAME}
SUPERUSER_CPF=${SUPERUSER_CPF}

# ──────────────────────────────────────────────
# Dev Settings (TODOS desativados em produção)
# ──────────────────────────────────────────────
DEV_AUTH_BYPASS=false
INTEGRITY_MOCK_MODE=false
PIX_MOCK_AUTO_CONFIRM=false
