# ──────────────────────────────────────────────
# Server (Production)
# ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1

# ──────────────────────────────────────────────
# Database (Docker Compose internal network)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://dominoclub:${POSTGRES_PASSWORD}@postgres:5432/dominoclub

# ──────────────────────────────────────────────
# JWT (Use strong secrets in production)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ──────────────────────────────────────────────
# CORS - Allow VPS IP and mobile app
# ──────────────────────────────────────────────
CORS_ORIGINS=http://34.233.108.8:3001,http://34.233.108.8:3000,http://localhost:3000,http://localhost:19006

# ──────────────────────────────────────────────
# Admin Dashboard
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}

# ──────────────────────────────────────────────
# Game Settings
# ──────────────────────────────────────────────
TURN_TIMEOUT_SECONDS=30
BOT_INJECT_WAIT_SECONDS=30
MATCHMAKING_BET_TOLERANCE=0.10
HOUSE_EDGE_PERCENT=10

# ──────────────────────────────────────────────
# Anti-fraud & Rate limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_COUNTRIES=BR
BOT_SCORE_THRESHOLD=0.8

# ──────────────────────────────────────────────
# OTP / SMS (Mock mode for initial deploy)
# ──────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=mock

# ──────────────────────────────────────────────
# PIX - Banco Inter (Sandbox for testing)
# ──────────────────────────────────────────────
INTER_CLIENT_ID=${INTER_CLIENT_ID}
INTER_CLIENT_SECRET=${INTER_CLIENT_SECRET}
INTER_BASE_URL=https://cdpj-sandbox.partners.uatinter.co
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
INTER_PIX_KEY=${INTER_PIX_KEY}
INTER_WEBHOOK_URL=http://34.233.108.8:3001/api/v1/wallet/pix/webhook
INTER_WEBHOOK_SECRET=${INTER_WEBHOOK_SECRET}

# ──────────────────────────────────────────────
# Serpro CPF Validation (Mock mode for initial deploy)
# ──────────────────────────────────────────────
SERPRO_API_KEY=${SERPRO_API_KEY}
SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br
SERPRO_MOCK_MODE=true

# ──────────────────────────────────────────────
# Superuser
# ──────────────────────────────────────────────
SUPERUSER_PHONE=${SUPERUSER_PHONE}
SUPERUSER_NAME=${SUPERUSER_NAME}
SUPERUSER_CPF=${SUPERUSER_CPF}

# ──────────────────────────────────────────────
# Dev Settings (DISABLED in production)
# ──────────────────────────────────────────────
DEV_AUTH_BYPASS=false
INTEGRITY_MOCK_MODE=false
PIX_MOCK_AUTO_CONFIRM=false
