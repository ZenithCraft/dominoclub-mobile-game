{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "679633365643-nscdct6m9aaqi0h67hiq9f7i365uok9f.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.19.4",
      "ios": { "simulator": false },
      "android": { "buildType": "apk", "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://34.233.108.8:3001/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://34.233.108.8:3001",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "true",
        "EXPO_PUBLIC_FORCE_DEV_LOGIN": "true",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "679633365643-nscdct6m9aaqi0h67hiq9f7i365uok9f.apps.googleusercontent.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://34.233.108.8:3001/api/v1",
        "EXPO_PUBLIC_MOCK_MODE": "false",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "true",
        "EXPO_PUBLIC_FORCE_DEV_LOGIN": "true",
        "EXPO_PUBLIC_SOCKET_URL": "http://34.233.108.8:3001",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "679633365643-nscdct6m9aaqi0h67hiq9f7i365uok9f.apps.googleusercontent.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "SEU_APPLE_ID@example.com",
        "ascAppId": "SEU_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "SEU_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
