{
  "name": "dominoclub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "apps/admin"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=apps/backend",
    "mobile": "npm run start --workspace=apps/mobile",
    "admin": "npm run dev --workspace=apps/admin",
    "dev": "concurrently \"npm run backend\" \"npm run admin\"",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.58.2"
  }
}
